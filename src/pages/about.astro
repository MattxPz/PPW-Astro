---
// 1. TODO LO QUE SEA JAVASCRIPT VA AQUÍ ARRIBA (FRONTMATTER)
import RecursoCard from '../components/RecursoCard.astro';

const titulo = "Acerca de Astro Campus";
const descripcion = "Proyecto incremental para aprender Astro en el contexto del curso PPW.";
const modoProduccion = import.meta.env.PROD;

const equipo = [
  { nombre: "Pablo Torres", rol: "Docente", github: "PabloT18" },
];

const herramientas = [
  {
    titulo: "Astro Documentation",
    url: "https://docs.astro.build",
    descripcion: "La guía oficial para aprender a construir sitios rápidos."
  },
  {
    titulo: "Tailwind CSS",
    url: "https://tailwindcss.com",
    descripcion: "Framework de utilidades CSS para diseño rápido."
  },
  {
    titulo: "MDN Web Docs",
    url: "https://developer.mozilla.org",
    descripcion: "Recursos esenciales para desarrolladores web."
  }
];

const mostrarHerramientas = herramientas.length > 0;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
  </head>
  <body>
    <main>
      <h1>{titulo}</h1>
      <p>{descripcion}</p>

      <h2>Equipo</h2>
      <ul>
        {equipo.map(p => (
          <li>
            <strong>{p.nombre}</strong> — {p.rol}
            {" · "}
            <a href={`https://github.com/${p.github}`} target="_blank" rel="noopener">
              GitHub
            </a>
          </li>
        ))}
      </ul>

      <section>
        <h2>Herramientas</h2>
        {mostrarHerramientas && (
          <div>
            {herramientas.map((herramienta) => (
              <RecursoCard 
                titulo={herramienta.titulo} 
                url={herramienta.url} 
                descripcion={herramienta.descripcion} 
              />
            ))}
          </div>
        )}
        {!mostrarHerramientas && <p>No hay herramientas disponibles.</p>}
      </section>

      <nav style="margin-top: 2rem;">
        <a href="/">← Inicio</a>
      </nav>

      <footer>
        {modoProduccion && (
          <p style="color: #22c55e; font-size: 0.8rem;">
            Versión de producción activa.
          </p>
        )}
        {!modoProduccion && (
          <p style="color: #f59e0b; font-size: 0.8rem;">
            Modo desarrollo — usa <code>pnpm build</code> para producción.
          </p>
        )}
      </footer>
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    background: #0f0f0f;
    color: #e8e8e8;
  }
  h1 { color: #FF5D01; }
  h2 { color: #FF5D01; border-bottom: 1px solid #333; padding-bottom: 0.5rem; margin-top: 2rem; }
  a { color: #FF5D01; }
  li { margin-bottom: 0.5rem; }
</style>